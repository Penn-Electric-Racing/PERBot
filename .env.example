# Copy to .env (cp .env.example .env) and fill in. Never commit .env.
# Everything not listed here has a working default in core/config.py.

# --- Required ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
NOTION_TOKEN=

# --- Strongly recommended ---
# Semantic search + written answers. Without it, search is keyword-only.
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Query classification / reranking.
GROQ_API_KEY=
# Downloads the nightly index from the GitHub release (needed if the repo is private).
GITHUB_TOKEN=
GITHUB_REPO=Penn-Electric-Racing/PERBot

# --- Index ---
# Paths are relative to the repo root; leave them unset unless you want the data elsewhere.
# INDEX_PATH=./data/index.json
# EMBEDDINGS_PATH=./data/embeddings.i8
# INDEX_STATUS_PATH=./data/index-status.json
AUTO_BOOTSTRAP_ON_MISSING_INDEX=true
CURRENT_REV=REV12
TOP_K_RESULTS=5
# Slack user IDs allowed to run /reindex (comma-separated).
SLACK_REINDEX_ALLOWED_USER_IDS=
# Only if /reindex on the server should include Google Drive (the nightly Action already does).
GDRIVE_SERVICE_ACCOUNT_JSON=

# --- /race leaderboard (Supabase service_role key stays on the server) ---
RACE_SUPABASE_URL=
RACE_SUPABASE_SERVICE_KEY=

# --- /benbuys (sends the requisition email from electric@) ---
BENBUYS_GMAIL_CLIENT_ID=
BENBUYS_GMAIL_CLIENT_SECRET=
BENBUYS_GMAIL_REFRESH_TOKEN=

# --- /arrivals photo matching ---
ARRIVALS_CHANNEL=

# --- Price check (runs inside the bot when enabled; README → Price check) ---
# Re-prices new Purchasing rows and DMs the Point of contact when the price moved. Uses the
# Slack/Notion tokens above, OPENAI_API_KEY to read product pages (always OpenAI), and needs a
# web search key (DuckDuckGo blocks cloud servers).
PRICE_CHECK_ENABLED=false
SERPER_API_KEY=
BRAVE_API_KEY=
# Optional: exact distributor prices and stock.
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Optional: where alerts go when the Point of contact has no Slack match.
PRICE_CHECK_CHANNEL=
# PRICE_CHECK_POLL_SECONDS=120
# PRICE_CHECK_MODEL=gpt-5-mini
# PRICE_CHECK_THRESHOLD_PCT=10
# PRICE_CHECK_MIN_DELTA_USD=0
# PRICE_CHECK_SETTLE_SECONDS=60
# PRICE_CHECK_MAX_PER_HOUR=20
# PRICE_CHECK_LOOKBACK_HOURS=168
