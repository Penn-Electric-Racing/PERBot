# PERBot dev/test instance. Copy to `.env.dev` and fill in, then run `npm run dev:test`.
# Dev mode (PERBOT_ENV=dev, DEV=true, or --dev) reads ONLY this file, never `.env`, and never
# falls back to the prod Notion IDs hard-coded in src/config.ts. Anything left blank is disabled/empty.

# --- Separate Slack app (install it in a test workspace, or in the PER workspace under another name) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_BOT_USER_ID=
SLACK_REINDEX_ALLOWED_USER_IDS=

# --- Separate Notion workspace: an internal integration there, shared with the test pages/DBs ---
NOTION_TOKEN=
# Comma-separated root pages to index (empty = everything the integration can see)
NOTION_ALLOWED_PAGE_IDS=
NOTION_INDEX_DATA_SOURCE_IDS=
NOTION_JOB_LOG_DS_ID=

# Sponsorship CRM
SPONSOR_BANK_DS_ID=
SPONSOR_PIPELINE_DS_ID=
SPONSOR_EMAIL_TEMPLATE_PAGE_ID=
SPONSOR_QUOTA_ROSTER_DS_ID=
SPONSOR_QUOTA_AUDIT_DS_ID=
SPONSOR_QUOTA_AUDIT_URL=
SPONSOR_WIN_CHANNEL=perbot-dev
SPONSOR_QUOTA_CHANNEL=perbot-dev

# Ops tasks
OPS_TASKS_DS_ID=
OPS_MEETINGS_DS_ID=
OPS_TASKS_MY_OPEN_URL=

# BenBuys (no email recipients by default in dev — set these only to test sends)
BENBUYS_PURCHASING_DS_ID=
BENBUYS_MAIL_TRANSPORT=webhook
BENBUYS_MAIL_WEBHOOK_URL=
BENBUYS_DIGIKEY_TO=
BENBUYS_CC=
BENBUYS_DIGIKEY_OPERATORS=

# Price check ledger
PRICE_CHECK_LEDGER_DS_ID=
PRICE_CHECK_LEDGER_URL=

# Meeting notes parent page
MEETING_NOTES_PARENT_PAGE_ID=

# Arrivals listener channel (empty disables)
ARRIVALS_CHANNEL=

# --- Shared API keys (can reuse prod's or use separate ones) ---
OPENAI_API_KEY=
GROQ_API_KEY=
HUNTER_API_KEY=

# Index is local-only in dev (./data-dev); the bot never downloads the prod release.
GITHUB_TOKEN=
